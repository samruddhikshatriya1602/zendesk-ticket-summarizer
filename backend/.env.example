PORT=3001
CORS_ORIGIN=http://localhost:5173

# Zendesk REST API
# ZENDESK_SUBDOMAIN=z3n-yourname
# ZENDESK_EMAIL=you@example.com
# ZENDESK_API_TOKEN=your_token

# Zendesk AI Gateway — https://ai-gateway.zende.sk/tokens/create
# AI_GATEWAY_API_KEY=your_key
# AI_GATEWAY_BASE_URL=https://ai-gateway.zende.sk/v1
# AI_GATEWAY_MODEL=gpt-5.5

# Optional summary cache TTL (ms)
# SUMMARY_CACHE_TTL_MS=3600000